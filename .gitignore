.aws/

# Carpetas temporales de uploads y downloads
uploads/*
!uploads/.gitignore
downloads/*
!downloads/.gitignore

# Terraform (cubre raíz y subcarpetas)
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
*.tfvars
