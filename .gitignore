# Entorno Virtual Python
aws-env/
venv/

# Variables de entorno y secretos
.env
.env.*

# Archivos Python generados y cachés
__pycache__/
*.pyc
*.pyo

# Archivos de Testing
.pytest_cache/
htmlcov/
.coverage

# Archivos temporales y del sistema operativo
*~
.DS_Store
.vscode/
.idea/

